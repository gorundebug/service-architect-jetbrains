<idea-plugin>
  <id>com.gorundebug.servicearchitect</id>
  <name>Service Architect</name>
  <vendor>gorundebug</vendor>
  <description>Read-only graph navigation for typed Service Architect Python projects.</description>
  <idea-version since-build="261"/>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.jcef</depends>
  <extensions defaultExtensionNs="com.intellij">
    <codeInsight.lineMarkerProvider language="" implementationClass="com.gorundebug.servicearchitect.GraphLineMarkerProvider"/>
    <toolWindow id="Service Architect" anchor="right"
                factoryClass="com.gorundebug.servicearchitect.GraphToolWindowFactory"/>
  </extensions>
  <actions>
    <action id="ServiceArchitect.ShowInGraph" class="com.gorundebug.servicearchitect.ShowInGraphAction"
            text="Service Architect: Show in Graph" description="Focus the graph node associated with the current code">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
